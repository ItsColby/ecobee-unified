{
  "entity": {
    "binary_sensor": {
      "source_degraded": {
        "default": "mdi:source-branch-check",
        "state": {
          "off": "mdi:source-branch-check",
          "on": "mdi:source-branch-alert"
        }
      }
    },
    "button": {
      "resume_program": {
        "default": "mdi:play"
      }
    },
    "number": {
      "minimum_fan_runtime": {
        "default": "mdi:fan-clock"
      }
    },
    "notify": {
      "notification": {
        "default": "mdi:message-alert"
      }
    },
    "sensor": {
      "equipment_stage": {
        "default": "mdi:hvac"
      }
    }
  },
  "services": {
    "create_vacation": {
      "service": "mdi:umbrella-beach"
    },
    "delete_vacation": {
      "service": "mdi:umbrella-beach-outline"
    },
    "resume_program": {
      "service": "mdi:play"
    },
    "set_occupancy_modes": {
      "service": "mdi:eye-settings"
    },
    "set_sensors_used_in_climate": {
      "service": "mdi:home-thermometer"
    }
  }
}
